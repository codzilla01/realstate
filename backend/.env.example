# ── Database ──────────────────────────────────────────────────────────────
# MySQL 8 / MariaDB 10.6+. Create the database first:
#   CREATE DATABASE realestate CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:password@localhost:3306/realestate"

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production: 32+ random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ── HTTP ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins, or * for any (dev only).
# Example: CORS_ORIGIN="https://your-domain.com,https://www.your-domain.com"
CORS_ORIGIN="*"
LOG_REQUESTS=true

# ── Uploads ───────────────────────────────────────────────────────────────
# Where uploaded property images are stored. Relative paths resolve against
# the backend folder; in production point this to a persistent volume.
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# ── OTP (login by SMS code) ───────────────────────────────────────────────
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
# In development the generated code is returned in the API response so the
# flow can be tested without an SMS provider. Ignored in production.
EXPOSE_DEV_OTP=true

# ── Bootstrap ─────────────────────────────────────────────────────────────
# Leave false in production: the first ADMIN is created by prisma/seed.js or
# from the dashboard (POST /api/users). Set true temporarily if you need the
# public /api/auth/register endpoint to create AGENT accounts.
ALLOW_PUBLIC_REGISTRATION=false
