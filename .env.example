# ── Docker Compose (.env in the project root) ─────────────────────────────
# Used by `docker compose up --build`. For a manual install use
# backend/.env.example and frontend/.env.example instead.

MYSQL_ROOT_PASSWORD="change-this-database-password"
MYSQL_DATABASE="realestate"

# 32+ random characters: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Origin that serves the frontend (used by CORS). "*" is fine when nginx and
# the API are on the same host; set it to your domain in production.
CORS_ORIGIN="*"

# Public port of the web container
WEB_PORT=8080

# Load the demo catalogue + demo users on first boot
SEED_ON_START=true

# push = sync schema directly (no migration history yet)
# migrate = use `prisma migrate deploy` once you committed real migrations
PRISMA_SYNC=push
