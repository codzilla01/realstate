# Postal inbox allowed to sign in. Do not commit .env or any SMTP credentials.
ADMIN_EMAIL=
SMTP_HOST=
# 587 uses required STARTTLS; 465 uses implicit TLS.
SMTP_PORT=587
# Verified sender address accepted by your SMTP provider.
SMTP_FROM=
# Set both values if the provider requires authentication.
SMTP_USER=
SMTP_PASSWORD=
PORT=3000
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
# Set false before using the platform with real properties.
SEED_DEMO=true

# Set these as SERVER environment variables on Vercel (not publicly prefixed).
# Create separate Turso databases/tokens for Production and Preview.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate a random value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Resend over HTTPS is recommended on Vercel; SMTP above still works for standalone hosts.
RESEND_API_KEY=
MAIL_FROM=
