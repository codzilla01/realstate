# One administrator. Use a unique password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Server settings. Hostinger provides PORT for managed Node.js apps.
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false

# Persistent SQLite file; on Hostinger set this to a writable path outside public_html.
DATABASE_PATH=./data/almaktab.sqlite
# true only for local demos; use false on a real listing site.
SEED_DEMO=true

# Only needed when deploying to Vercel; Hostinger runs with SQLite by default.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
