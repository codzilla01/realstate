# One approved Google account (Gmail or Google Workspace). Do not commit .env.
ADMIN_GOOGLE_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local development. On Vercel use the exact HTTPS production callback URL.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/login/google/callback
PORT=3000
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
# Set false before using the platform with real properties.
SEED_DEMO=true

# Set these as server environment variables on Vercel (not publicly prefixed).
# Create separate Turso databases/tokens for Production and Preview.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
