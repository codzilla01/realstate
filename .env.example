# One administrative account. No defaults. Do not commit .env.
# Username: 3–64 ASCII letters, digits, dots, underscores, or hyphens.
ADMIN_USERNAME=
# Generate with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=
PORT=3000
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
# Set false before using the platform with real properties.
SEED_DEMO=true

# Set these as server environment variables on Vercel (not publicly prefixed).
# Create separate Turso databases/tokens for Production and Preview.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
